{
  "name": "fastify-postgres-boilerplate",
  "version": "2.0.0",
  "description": "Loan origination and weekly repayment REST API: Fastify 5, TypeScript and PostgreSQL, with SQL migrations, row-locked repayments, health checks and OpenAPI docs.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node build/src/index.js",
    "migrate": "node build/src/index.js migrate",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude='build/test/**' 'build/test/**/*.test.js'",
    "test:unit": "tsc -p tsconfig.json && node --test 'build/test/unit/*.test.js'",
    "pretty": "prettier --write \"{src,test}/**/*.ts\"",
    "pretty:check": "prettier --check \"{src,test}/**/*.ts\"",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "prepare": "husky || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/the-vishal-kumar/fastify-postgres-boilerplate.git"
  },
  "author": "Vishal Kumar <vishal194kumar@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/the-vishal-kumar/fastify-postgres-boilerplate#readme",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.2",
    "@fastify/helmet": "^13.2.0",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "swagger-ui-dist": "^5.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "husky": "^9.1.7",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2"
  }
}
