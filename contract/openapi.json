{
  "openapi": "3.1.0",
  "info": {
    "title": "Loan API",
    "version": "2.0.0",
    "description": "Customers request a loan with an amount and a term in weeks, an admin approves it, and the\ncustomer pays the weekly instalments. A loan becomes `PAID` when the last instalment is paid.\n\n**Try it:** sign up and sign in with `/auth/signup` and `/auth/signin`, copy `data.accessToken`,\npress **Authorize** and paste the token. Admin sign-up only works when the server runs with\n`ADMIN_SIGNUP_ENABLED=true`.\n\nEvery response carries an `X-Request-Id` header. Quote it when reporting a problem."
  },
  "tags": [
    {
      "name": "Auth",
      "description": "Accounts and sessions"
    },
    {
      "name": "Loans",
      "description": "Loan requests and approval"
    },
    {
      "name": "Repayments",
      "description": "Weekly instalments"
    },
    {
      "name": "Health",
      "description": "Liveness and readiness probes"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": [
          "status",
          "error"
        ],
        "properties": {
          "status": {
            "type": "integer",
            "examples": [
              422
            ]
          },
          "error": {
            "type": "string",
            "examples": [
              "Validation error"
            ]
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "examples": [
              [
                "\"amount\" is required"
              ]
            ]
          },
          "requestId": {
            "type": "string",
            "description": "Present on 500 responses."
          }
        }
      },
      "Signup": {
        "type": "object",
        "required": [
          "email",
          "password",
          "firstName"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "examples": [
              "user@example.com"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "examples": [
              "strong-password"
            ]
          },
          "firstName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100,
            "examples": [
              "Ada"
            ]
          },
          "lastName": {
            "type": "string",
            "maxLength": 100,
            "examples": [
              "Lovelace"
            ]
          }
        }
      },
      "Signin": {
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "maxLength": 254,
            "examples": [
              "user@example.com"
            ]
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "examples": [
              "strong-password"
            ]
          }
        }
      },
      "ResetPassword": {
        "type": "object",
        "required": [
          "currentPassword",
          "password"
        ],
        "additionalProperties": false,
        "properties": {
          "currentPassword": {
            "type": "string",
            "maxLength": 128,
            "examples": [
              "strong-password"
            ]
          },
          "password": {
            "type": "string",
            "minLength": 8,
            "maxLength": 128,
            "examples": [
              "a-new-strong-password"
            ]
          }
        }
      },
      "AccessToken": {
        "type": "object",
        "properties": {
          "status": {
            "type": "integer",
            "examples": [
              200
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "accessToken": {
                "type": "string",
                "description": "JWT. Users: 24 h, admins: 20 min."
              }
            }
          }
        }
      },
      "LoanRequest": {
        "type": "object",
        "required": [
          "amount",
          "term"
        ],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000000000,
            "description": "At most two decimal places.",
            "examples": [
              10000
            ]
          },
          "term": {
            "type": "integer",
            "minimum": 1,
            "maximum": 520,
            "description": "Weeks.",
            "examples": [
              3
            ]
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": [
          "amount"
        ],
        "additionalProperties": false,
        "properties": {
          "amount": {
            "type": "number",
            "minimum": 0.01,
            "maximum": 1000000000,
            "description": "At most two decimal places. At least the next due instalment; any surplus pays later instalments.",
            "examples": [
              3333.34
            ]
          }
        }
      },
      "Status": {
        "type": "string",
        "enum": [
          "PENDING",
          "APPROVED",
          "PAID"
        ]
      },
      "Repayment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "loanId": {
            "type": "string",
            "format": "uuid"
          },
          "dueAmount": {
            "type": "number",
            "examples": [
              3333.34
            ]
          },
          "paidAmount": {
            "type": "number",
            "examples": [
              0
            ]
          },
          "isLast": {
            "type": "boolean"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "dueDate": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix seconds"
          },
          "updatedAt": {
            "type": "integer",
            "description": "Unix seconds"
          }
        }
      },
      "Loan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "userId": {
            "type": "string",
            "format": "uuid"
          },
          "amount": {
            "type": "number",
            "examples": [
              10000
            ]
          },
          "term": {
            "type": "integer",
            "examples": [
              3
            ]
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "createdAt": {
            "type": "integer",
            "description": "Unix seconds"
          },
          "updatedAt": {
            "type": "integer",
            "description": "Unix seconds"
          },
          "repayments": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Repayment"
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create a customer account",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signup"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Account created"
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many authentication attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup/admin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Create an admin account (only when ADMIN_SIGNUP_ENABLED=true)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signup"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Admin created"
          },
          "403": {
            "description": "Admin sign-up is disabled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Email already registered",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many authentication attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in and get an access token",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many authentication attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signin/admin": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Sign in as an admin (short-lived token)",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Signin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Signed in",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccessToken"
                }
              }
            }
          },
          "401": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The account is not an admin",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many authentication attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/signoff": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "End the current session",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Signed off"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/password/reset": {
      "put": {
        "tags": [
          "Auth"
        ],
        "summary": "Change password and end all other sessions",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ResetPassword"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Password changed"
          },
          "401": {
            "description": "Missing token or wrong current password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "New password equals the old one",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many authentication attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/loan": {
      "post": {
        "tags": [
          "Loans"
        ],
        "summary": "Request a loan",
        "description": "Creates the loan and its weekly schedule, both `PENDING`. Cents are spread so the sum is exact.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoanRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Loan created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer",
                      "examples": [
                        201
                      ]
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Loans"
        ],
        "summary": "List my loans with their schedules",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Loans of the caller",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Loan"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/loan/{id}": {
      "get": {
        "tags": [
          "Loans"
        ],
        "summary": "Get one of my loans",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Public loan id (UUID v4), as returned by `POST /loan`.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The loan",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "integer"
                    },
                    "data": {
                      "$ref": "#/components/schemas/Loan"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "The loan belongs to someone else",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Loan not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "id is not a UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/loan/{id}/approve": {
      "put": {
        "tags": [
          "Loans"
        ],
        "summary": "Approve a pending loan (admin)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Public loan id (UUID v4), as returned by `POST /loan`.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Approved"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not an admin, own loan, or loan not pending",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Loan not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Approved concurrently by another request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "id is not a UUID",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/loan/{id}/repayment": {
      "put": {
        "tags": [
          "Repayments"
        ],
        "summary": "Pay the next instalment(s)",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Public loan id (UUID v4), as returned by `POST /loan`.",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Payment"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Payment applied"
          },
          "401": {
            "description": "Missing or invalid token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Not the owner, loan not approved, amount below the due instalment or above the balance",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Loan not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Another payment on this loan is in progress, retry",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Invalid payload",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Liveness probe (no dependencies checked)",
        "responses": {
          "200": {
            "description": "Process is up"
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Readiness probe (database reachable, not shutting down)",
        "responses": {
          "200": {
            "description": "Ready"
          },
          "503": {
            "description": "Not ready"
          }
        }
      }
    }
  }
}
